{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "issa-upload-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-07-16",

  "observability": {
    "enabled": true
  },

  "compatibility_flags": [
    "nodejs_compat"
  ],

  "upload_source_maps": true,

  "r2_buckets": [
    {
      "binding": "VIDEOS",
      "bucket_name": "issa-academy-videos"
    }
  ]
}